rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Prevent deletion

      // User's personalized roadmaps subcollection
      match /roadmaps/{domain} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // User's roadmap progress tracking (step completion, current step, etc.)
      match /roadmapProgress/{domain} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // User's chat sessions (AI Mentor general chat + per-roadmap chat)
      match /chats/{domain} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Usage counters are written by server (Admin SDK) only — no client access needed
    }

    // AI-generated global roadmap base templates — authenticated read, server-write only
    match /roadmaps/{domain} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Admin SDK (cron jobs) can write
    }

    // AI-curated weekly learning resources — authenticated read, server-write only
    match /learning-resources/{domain}/weeks/{weekId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Admin SDK (cron jobs) can write
    }

    // Public stats document (read-only for all, write by authenticated users for increment)
    match /public/stats {
      allow read: if true;
      allow update: if isAuthenticated();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
